<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gh_bg_screen">

    <!-- Background Decorative Glows -->
    <View
        android:id="@+id/glow_top_left"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:layout_marginStart="-150dp"
        android:alpha="0.6"
        android:background="@drawable/bg_screen_glow_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Mock Status Bar (Giả lập thanh trạng thái cho giống thiết kế) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/statusBarMock"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarMock">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp"
            android:paddingBottom="32dp">

            <!-- Logo: Đẩy lùi xuống thêm một chút -->
            <ImageView
                android:id="@+id/ivIllustration"
                android:layout_width="381dp"
                android:layout_height="244dp"
                android:layout_marginTop="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/img_login_logo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Tiêu đề Đăng nhập với màu 23A141 và hiệu ứng viền màu A1FFB7 -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Đăng nhập"
                android:textColor="#23A141"
                android:textSize="36sp"
                android:textStyle="bold"
                android:shadowColor="#A1FFB7"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivIllustration" />

            <!-- Email Field -->
            <TextView
                android:id="@+id/tvEmailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Email"
                android:textColor="#251B6D"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_login"
                android:hint="Nhập email"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="24dp"
                android:textColor="#1F2937"
                app:layout_constraintTop_toBottomOf="@+id/tvEmailLabel" />

            <!-- Password Field -->
            <TextView
                android:id="@+id/tvPasswordLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Mật khẩu"
                android:textColor="#251B6D"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etEmail" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:hintEnabled="false"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="#6B7280"
                app:layout_constraintTop_toBottomOf="@+id/tvPasswordLabel">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_input_login"
                    android:hint="Nhập mật khẩu"
                    android:inputType="textPassword"
                    android:paddingHorizontal="24dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Login Button -->
            <android.widget.Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="40dp"
                android:background="@drawable/bg_button_login_gradient"
                android:elevation="4dp"
                android:text="Đăng nhập"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:shadowColor="#135A24"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6"
                app:layout_constraintTop_toBottomOf="@+id/tilPassword" />

            <!-- Register Link: Sát nút bấm hơn, màu xanh 135A24 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnLogin">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bạn chưa có tài khoản? "
                    android:textColor="#6B7280" />

                <TextView
                    android:id="@+id/tvRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đăng ký"
                    android:textColor="#135A24"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:id="@+id/glow_bottom_right"
                android:layout_width="450dp"
                android:layout_height="450dp"
                android:alpha="0.5"
                android:background="@drawable/bg_screen_glow_warm"
                tools:layout_editor_absoluteX="139dp"
                tools:layout_editor_absoluteY="453dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
