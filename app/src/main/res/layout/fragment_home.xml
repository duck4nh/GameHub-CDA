<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gh_bg_screen">

    <!-- Background Decorative Glows -->
    <View
        android:id="@+id/glow_top_left"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:layout_marginStart="-150dp"
        android:layout_marginTop="-150dp"
        android:background="@drawable/bg_screen_glow_light_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/glow_center_right"
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:layout_marginEnd="-100dp"
        android:background="@drawable/bg_screen_glow_light_blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/glow_bottom_left"
        android:layout_width="380dp"
        android:layout_height="380dp"
        android:layout_marginStart="-120dp"
        android:layout_marginBottom="-100dp"
        android:background="@drawable/bg_screen_glow_light_blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Header Section -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivHomeProfile"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/img_avatar_cat"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                app:strokeColor="#782A62"
                app:strokeWidth="2dp" />

            <TextView
                android:id="@+id/tvHomeUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:text="qyuhn"
                android:textColor="#251B6D"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/ivHomeProfile"
                app:layout_constraintTop_toTopOf="@id/ivHomeProfile" />

            <TextView
                android:id="@+id/tvHomeRank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hạng: 2"
                android:textColor="#6B7280"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="@id/tvHomeUsername"
                app:layout_constraintTop_toBottomOf="@id/tvHomeUsername" />

            <!-- Greeting Text (Replacing Search Bar) -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Chào mừng bạn quay trở lại!"
                android:textColor="#251B6D"
                android:textSize="20sp"
                android:textStyle="italic"
                app:layout_constraintTop_toBottomOf="@id/ivHomeProfile" />

            <!-- Recently Accessed -->
            <TextView
                android:id="@+id/tvRecentLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Truy cập gần đây"
                android:textColor="#251B6D"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvGreeting" />

            <HorizontalScrollView
                android:id="@+id/hsvRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none"
                app:layout_constraintTop_toBottomOf="@id/tvRecentLabel">

                <LinearLayout
                    android:id="@+id/llRecentGamesContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="4dp">
                    <!-- Dynamic Recent Games Items will be added here -->
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Recent Activity Section -->
            <LinearLayout
                android:id="@+id/llRecentActivityContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_profile_row_blue"
                android:orientation="vertical"
                android:padding="20dp"
                app:layout_constraintTop_toBottomOf="@id/hsvRecent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hoạt động gần đây"
                    android:textColor="#251B6D"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvActivitySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Một nơi tổng hợp tiến trình và lịch sử chơi của bạn."
                    android:textColor="#6B7280"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/llActivityList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">
                    <!-- Dynamic Activity Items will be added here -->
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNoActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="Không có hoạt động nào gần đây"
                    android:textColor="#9CA3AF"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Hidden Views for original logic -->
            <View android:id="@+id/llRecentSudoku" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <View android:id="@+id/llRecentMemory" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <View android:id="@+id/llRecentQuiz" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <GridLayout android:id="@+id/glGames" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

            <!-- Dummy view to avoid crashes if Java code still looks for etSearchGame -->
            <EditText android:id="@+id/etSearchGame" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" tools:ignore="MissingConstraints" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
