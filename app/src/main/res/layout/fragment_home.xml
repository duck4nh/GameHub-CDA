<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gh_bg_screen">

    <!-- Background Decorative Glows -->
    <View
        android:id="@+id/glow_top_left"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:layout_marginStart="-150dp"
        android:layout_marginTop="-150dp"
        android:background="@drawable/bg_screen_glow_light_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/glow_center_right"
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:layout_marginEnd="-100dp"
        android:background="@drawable/bg_screen_glow_light_blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/glow_bottom_left"
        android:layout_width="380dp"
        android:layout_height="380dp"
        android:layout_marginStart="-120dp"
        android:layout_marginBottom="-100dp"
        android:background="@drawable/bg_screen_glow_light_blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Header Section -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivHomeProfile"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/img_avatar_cat"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                app:strokeColor="#782A62"
                app:strokeWidth="2dp" />

            <TextView
                android:id="@+id/tvHomeUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:text="qyuhn"
                android:textColor="#251B6D"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/ivHomeProfile"
                app:layout_constraintTop_toTopOf="@id/ivHomeProfile" />

            <TextView
                android:id="@+id/tvHomeRank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hạng: 2"
                android:textColor="#6B7280"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="@id/tvHomeUsername"
                app:layout_constraintTop_toBottomOf="@id/tvHomeUsername" />

            <!-- Search Bar Area -->
            <LinearLayout
                android:id="@+id/llSearchBarContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_search_bar"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@id/ivHomeProfile">

                <EditText
                    android:id="@+id/etSearchGame"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Tìm kiếm trò chơi...."
                    android:inputType="text"
                    android:textColor="#1F2937"
                    android:textColorHint="#9CA3AF"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/ivSearchIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#6B7280" />
            </LinearLayout>

            <!-- Recently Accessed (Hidden when searching) -->
            <TextView
                android:id="@+id/tvRecentLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Truy cập gần đây"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/llSearchBarContainer" />

            <HorizontalScrollView
                android:id="@+id/hsvRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none"
                app:layout_constraintTop_toBottomOf="@id/tvRecentLabel">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/llRecentSudoku"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_profile_row"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:layout_marginEnd="12dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/img_home_sudoku" android:layout_marginEnd="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sudoku" android:textColor="#000000" android:textSize="14sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llRecentMemory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_profile_row"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:layout_marginEnd="12dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/img_home_memory" android:layout_marginEnd="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lật hình" android:textColor="#000000" android:textSize="14sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llRecentQuiz"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_profile_row"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/img_home_quiz" android:layout_marginEnd="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quiz Game" android:textColor="#000000" android:textSize="14sp"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Games Grid Section -->
            <TextView
                android:id="@+id/tvGamesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Trò chơi"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/hsvRecent" />

            <GridLayout
                android:id="@+id/glGames"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                app:layout_constraintTop_toBottomOf="@id/tvGamesLabel">

                <!-- Sudoku Card -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardSudoku"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/bgSudoku"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_home_game_sudoku"
                        android:elevation="2dp"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivSudokuIcon"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:elevation="6dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_home_sudoku"
                        app:layout_constraintBottom_toTopOf="@+id/tvSudokuTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.3"
                        app:shapeAppearanceOverlay="@style/RoundedRectangleImageView"
                        app:strokeColor="#7C3AED"
                        app:strokeWidth="2dp" />

                    <TextView
                        android:id="@+id/tvSudokuTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:elevation="4dp"
                        android:text="SUDOKU"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Memory Card -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardMemory"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/bgMemory"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_home_game_memory"
                        android:elevation="2dp"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivMemoryIcon"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:elevation="6dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_home_memory"
                        app:layout_constraintBottom_toTopOf="@+id/tvMemoryTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.3"
                        app:shapeAppearanceOverlay="@style/RoundedRectangleImageView"
                        app:strokeColor="#C2410C"
                        app:strokeWidth="2dp" />

                    <TextView
                        android:id="@+id/tvMemoryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:elevation="4dp"
                        android:text="Lật hình"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Quiz Card -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardQuiz"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/bgQuiz"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_home_game_quiz"
                        android:elevation="2dp"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivQuizIcon"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:elevation="6dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_home_quiz"
                        app:layout_constraintBottom_toTopOf="@+id/tvQuizTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.3"
                        app:shapeAppearanceOverlay="@style/RoundedRectangleImageView"
                        app:strokeColor="#15803D"
                        app:strokeWidth="2dp" />

                    <TextView
                        android:id="@+id/tvQuizTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:elevation="4dp"
                        android:text="Quiz Game"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </GridLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
