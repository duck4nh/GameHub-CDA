<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gh_bg_screen">

    <View
        android:layout_width="232dp"
        android:layout_height="232dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-42dp"
        android:layout_marginEnd="-32dp"
        android:background="@drawable/bg_screen_glow_blue" />

    <View
        android:layout_width="196dp"
        android:layout_height="196dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-86dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/bg_screen_glow_warm" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/history_detail_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_back_button"
                    android:clickable="true"
                    android:contentDescription="Quay lại"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/gh_text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Chi tiết trận"
                        android:textColor="@color/gh_text_primary"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/history_detail_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gh_text_secondary"
                        android:textSize="11sp"
                        tools:text="Trận này đã được ghi lại trong lịch sử của bạn" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_warning_24"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/history_detail_overview_game"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gh_text_secondary"
                    android:textSize="11sp"
                    tools:text="Sudoku · Khó" />

                <TextView
                    android:id="@+id/history_detail_overview_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/gh_text_primary"
                    android:textSize="24sp"
                    tools:text="Hoàn thành trong 09:14" />

                <TextView
                    android:id="@+id/history_detail_overview_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/gh_text_secondary"
                    android:textSize="14sp"
                    tools:text="1 lỗi · 0 gợi ý · Hoàn thành ngày 27/03" />

                <TextView
                    android:id="@+id/history_detail_sync_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_chip_success"
                    android:paddingStart="18dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/gh_text_primary"
                    android:textSize="12sp"
                    tools:text="Đã lưu" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="116dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_surface_22"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/history_detail_primary_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gh_text_secondary"
                        android:textSize="11sp"
                        tools:text="Lượt" />

                    <TextView
                        android:id="@+id/history_detail_primary_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/gh_text_primary"
                        android:textSize="24sp"
                        tools:text="81" />

                    <TextView
                        android:id="@+id/history_detail_primary_caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/gh_text_secondary"
                        android:textSize="14sp"
                        tools:text="Bản ghi của phiên này" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="116dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_brand_22"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/history_detail_secondary_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gh_text_secondary"
                        android:textSize="11sp"
                        tools:text="Chính xác" />

                    <TextView
                        android:id="@+id/history_detail_secondary_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/gh_text_primary"
                        android:textSize="24sp"
                        tools:text="98%" />

                    <TextView
                        android:id="@+id/history_detail_secondary_caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/gh_text_secondary"
                        android:textSize="14sp"
                        tools:text="1 lỗi đã được sửa" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_surface_24"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Ghi chú phiên"
                    android:textColor="@color/gh_text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/history_detail_notes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/gh_text_secondary"
                    android:textSize="14sp"
                    tools:text="Bạn có thể xem lại thời gian, điểm số và kết quả của trận này tại đây." />
            </LinearLayout>

            <TextView
                android:id="@+id/history_detail_play_similar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_pill_brand_soft"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/gh_text_primary"
                android:textSize="14sp"
                tools:text="Chơi bàn tương tự" />

            <TextView
                android:id="@+id/history_detail_view_statistics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Xem toàn bộ thống kê"
                android:textColor="@color/gh_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
