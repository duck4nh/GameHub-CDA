<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gh_bg_screen">

    <View
        android:layout_width="232dp"
        android:layout_height="232dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-42dp"
        android:layout_marginEnd="-32dp"
        android:background="@drawable/bg_screen_glow_blue" />

    <View
        android:layout_width="196dp"
        android:layout_height="196dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-86dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/bg_screen_glow_warm" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/stats_header_avatar"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/img_avatar_cat"
                    app:shapeAppearanceOverlay="@style/CircleImageView"
                    app:strokeColor="@color/gh_text_primary"
                    app:strokeWidth="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Thống kê"
                        android:textColor="@color/gh_text_primary"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tiến trình của bạn trên các game"
                        android:textColor="@color/gh_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/bg_avatar_placeholder" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="116dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_brand_22"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Điểm tuần"
                        android:textColor="@color/gh_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/metric_weekly_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/gh_text_primary"
                        android:textSize="24sp"
                        tools:text="1,248" />

                    <TextView
                        android:id="@+id/metric_weekly_delta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/gh_text_secondary"
                        android:textSize="14sp"
                        tools:text="+12% so với tuần trước" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="116dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_success_22"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chuỗi"
                        android:textColor="@color/gh_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/metric_streak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/gh_text_primary"
                        android:textSize="24sp"
                        tools:text="6 ngày" />

                    <TextView
                        android:id="@+id/metric_streak_caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Số ngày chơi liên tiếp"
                        android:textColor="@color/gh_text_secondary"
                        android:textSize="14sp"
                        tools:text="Số ngày chơi liên tiếp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_surface_24"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Nhịp chơi trong tuần"
                            android:textColor="@color/gh_text_primary"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/chart_overview_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Chưa có trận nào trong tuần này"
                            android:textColor="@color/gh_text_secondary"
                            android:textSize="12sp"
                            tools:text="Cao nhất vào T7" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/chart_week_total_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_stats_value_chip"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp"
                        android:text="0 trận"
                        android:textColor="@color/gh_text_primary"
                        android:textSize="11sp"
                        tools:text="12 trận" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="172dp"
                    android:layout_marginTop="18dp"
                    android:baselineAligned="false"
                    android:gravity="bottom|center_horizontal"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/bar_value_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_stats_value_chip"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/gh_text_primary"
                            android:textSize="11sp"
                            tools:text="2" />

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="116dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_stats_bar_track"
                            android:padding="4dp">

                            <View
                                android:id="@+id/bar_day_1"
                                android:layout_width="match_parent"
                                android:layout_height="18dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/bg_stats_bar_fill" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/bar_label_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="T2"
                            android:textColor="@color/gh_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/bar_value_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_stats_value_chip"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/gh_text_primary"
                            android:textSize="11sp"
                            tools:text="3" />

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="116dp"
                            android:layout_marginTop="10dp"
