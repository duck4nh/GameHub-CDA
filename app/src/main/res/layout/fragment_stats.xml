                        </FrameLayout>

                        <TextView
                            android:id="@+id/bar_label_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="T5"
                            android:textColor="@color/gh_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/bar_value_5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_stats_value_chip"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/gh_text_primary"
                            android:textSize="11sp"
                            tools:text="2" />

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="116dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_stats_bar_track"
                            android:padding="4dp">

                            <View
                                android:id="@+id/bar_day_5"
                                android:layout_width="match_parent"
                                android:layout_height="18dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/bg_stats_bar_fill" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/bar_label_5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="T6"
                            android:textColor="@color/gh_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/bar_value_6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_stats_value_chip_active"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/gh_text_primary"
                            android:textSize="11sp"
                            tools:text="5" />

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="116dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_stats_bar_track"
                            android:padding="4dp">

                            <View
                                android:id="@+id/bar_day_6"
                                android:layout_width="match_parent"
                                android:layout_height="18dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/bg_stats_bar_fill_active" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/bar_label_6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="T7"
                            android:textColor="@color/gh_text_primary"
                            android:textStyle="bold"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/bar_value_7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_stats_value_chip"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/gh_text_primary"
                            android:textSize="11sp"
                            tools:text="3" />

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="116dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_stats_bar_track"
                            android:padding="4dp">

                            <View
                                android:id="@+id/bar_day_7"
                                android:layout_width="match_parent"
                                android:layout_height="18dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/bg_stats_bar_fill" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/bar_label_7"
