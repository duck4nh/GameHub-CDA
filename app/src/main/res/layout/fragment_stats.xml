                            android:padding="4dp">

                            <View
                                android:id="@+id/bar_day_2"
                                android:layout_width="match_parent"
                                android:layout_height="18dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/bg_stats_bar_fill" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/bar_label_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="T3"
                            android:textColor="@color/gh_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/bar_value_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_stats_value_chip"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/gh_text_primary"
                            android:textSize="11sp"
                            tools:text="1" />

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="116dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_stats_bar_track"
                            android:padding="4dp">

                            <View
                                android:id="@+id/bar_day_3"
                                android:layout_width="match_parent"
                                android:layout_height="18dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/bg_stats_bar_fill" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/bar_label_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="T4"
                            android:textColor="@color/gh_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/bar_value_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_stats_value_chip"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/gh_text_primary"
                            android:textSize="11sp"
                            tools:text="4" />

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="116dp"
