<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gh_bg_screen">

    <View
        android:layout_width="232dp"
        android:layout_height="232dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-42dp"
        android:layout_marginEnd="-32dp"
        android:background="@drawable/bg_screen_glow_blue" />

    <View
        android:layout_width="196dp"
        android:layout_height="196dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-86dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/bg_screen_glow_warm" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/history_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_back_button"
                    android:clickable="true"
                    android:contentDescription="Quay lại"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/gh_text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/history_title"
                        android:textColor="@color/gh_text_primary"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/history_subtitle"
                        android:textColor="@color/gh_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/filter_all"
                        android:layout_width="80dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_filter_selected"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/history_filter_all"
                        android:textColor="@color/gh_text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/filter_quiz"
                        android:layout_width="80dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_filter_unselected"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/history_filter_quiz"
                        android:textColor="@color/gh_text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/filter_memory"
                        android:layout_width="80dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_filter_unselected"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/history_filter_memory"
                        android:textColor="@color/gh_text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/filter_sudoku"
                        android:layout_width="80dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_filter_unselected"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/history_filter_sudoku"
                        android:textColor="@color/gh_text_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/history_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_history" />

            <LinearLayout
                android:id="@+id/queue_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_brand_20"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone"
                tools:visibility="gone">

                <TextView
                    android:id="@+id/queue_banner_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/gh_text_primary"
                    android:textSize="14sp"
                    tools:text="Kết quả mới" />

                <TextView
                    android:id="@+id/queue_banner_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/gh_text_secondary"
                    android:textSize="14sp"
                    tools:text="Kết quả sẽ được tải lên khi có mạng." />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
