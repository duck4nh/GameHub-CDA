<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gh_bg_screen">

    <View
        android:layout_width="232dp"
        android:layout_height="232dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-42dp"
        android:layout_marginEnd="-32dp"
        android:background="@drawable/bg_screen_glow_blue" />

    <View
        android:layout_width="196dp"
        android:layout_height="196dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-86dp"
        android:layout_marginBottom="72dp"
        android:background="@drawable/bg_screen_glow_warm" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/leaderboard_header_avatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/img_avatar_cat"
                    app:shapeAppearanceOverlay="@style/CircleImageView"
                    app:strokeColor="@color/gh_border"
                    app:strokeWidth="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Bảng xếp hạng"
                        android:textColor="@color/gh_text_primary"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xếp hạng theo tuần và toàn thời gian"
                        android:textColor="@color/gh_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/leaderboard_toggle"
                android:layout_width="280dp"
                android:layout_height="52dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_segmented_container"
                android:orientation="horizontal"
                android:padding="6dp">

                <TextView
                    android:id="@+id/weekly_tab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmented_selected"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/leaderboard_weekly"
                    android:textColor="@color/gh_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/all_time_tab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/leaderboard_all_time"
                    android:textColor="@color/gh_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/leaderboard_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Đang tải bảng xếp hạng..."
                android:textColor="@color/gh_text_secondary"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_warning_24"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top xếp hạng"
                    android:textColor="@color/gh_text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="bottom|center_horizontal"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="144dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_surface_20"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/podium_avatar_second"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_gravity="center"
                                android:src="@drawable/img_avatar_cat"
                                app:shapeAppearanceOverlay="@style/CircleImageView"
                                app:strokeColor="@color/gh_border"
                                app:strokeWidth="1dp" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_leaderboard_medal_silver"
                                android:padding="4dp"
                                android:src="@drawable/ic_leaderboard"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/podium_rank_second"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="#2"
                            android:textColor="@color/gh_text_primary"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/podium_name_second"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="Minh"
                            android:textColor="@color/gh_text_primary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/podium_score_second"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="980 điểm"
                            android:textColor="@color/gh_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="166dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_surface_20"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <FrameLayout
                            android:layout_width="58dp"
                            android:layout_height="58dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/podium_avatar_first"
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                android:layout_gravity="center"
                                android:src="@drawable/img_avatar_cat"
                                app:shapeAppearanceOverlay="@style/CircleImageView"
                                app:strokeColor="@color/gh_border"
                                app:strokeWidth="1dp" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_leaderboard_medal_gold"
                                android:padding="4dp"
                                android:src="@drawable/ic_leaderboard"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/podium_rank_first"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="#1"
                            android:textColor="@color/gh_text_primary"
                            android:textSize="24sp" />

                        <TextView
                            android:id="@+id/podium_name_first"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="Linh"
                            android:textColor="@color/gh_text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/podium_score_first"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="1.042 điểm"
                            android:textColor="@color/gh_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="144dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_surface_20"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/podium_avatar_third"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_gravity="center"
                                android:src="@drawable/img_avatar_cat"
                                app:shapeAppearanceOverlay="@style/CircleImageView"
                                app:strokeColor="@color/gh_border"
                                app:strokeWidth="1dp" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_leaderboard_medal_bronze"
                                android:padding="4dp"
                                android:src="@drawable/ic_leaderboard"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/podium_rank_third"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="#3"
                            android:textColor="@color/gh_text_primary"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/podium_name_third"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="Trang"
                            android:textColor="@color/gh_text_primary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/podium_score_third"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="950 điểm"
                            android:textColor="@color/gh_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_brand_22"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/current_user_avatar"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/img_avatar_cat"
                    app:shapeAppearanceOverlay="@style/CircleImageView"
                    app:strokeColor="@color/gh_border"
                    app:strokeWidth="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/current_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bạn"
                        android:textColor="@color/gh_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/current_user_rank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="#18 · 1.042 điểm"
                        android:textColor="@color/gh_text_primary"
                        android:textSize="22sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/current_user_trend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_brand_soft"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="+8 bậc tuần này"
                    android:textColor="@color/gh_text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/leaderboard_empty_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_surface_20"
                android:gravity="center"
                android:padding="18dp"
                android:text="Chưa có dữ liệu để xếp hạng."
                android:textColor="@color/gh_text_secondary"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/leaderboard_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_leaderboard" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
