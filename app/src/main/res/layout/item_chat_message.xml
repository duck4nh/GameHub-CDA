<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/chat_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_surface_22"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/chat_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trang · 10:14"
            android:textColor="@color/gh_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/chat_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxWidth="230dp"
            android:text="Ai rảnh đấu Ghi nhớ sau giờ học?"
            android:textColor="@color/gh_text_primary"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
