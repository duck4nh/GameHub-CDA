<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingStart="20dp"
    android:paddingTop="22dp"
    android:paddingEnd="20dp"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quiz_play_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_back_button"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/gh_text_primary"
                android:textSize="24sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/quiz_play_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Kiến thức tổng hợp"
                    android:textColor="@color/gh_text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/quiz_play_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Câu 1 / 20"
                    android:textColor="@color/gh_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/quiz_pause"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_card_surface_20"
                android:gravity="center"
                android:text="⋯"
                android:textColor="@color/gh_text_secondary"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/quiz_progress_track"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_progress_track">

                <View
                    android:id="@+id/quiz_progress_fill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_progress_fill" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="132dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_card_brand_20"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_primary_button_round"
                    android:gravity="center"
                    android:text="T"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Còn lại"
                        android:textColor="@color/gh_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/quiz_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="00:00"
                        android:textColor="@color/gh_text_primary"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_surface_24"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Câu hỏi"
                android:textColor="@color/gh_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/quiz_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="..."
                android:textColor="@color/gh_text_primary"
                android:textSize="18sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_brand_22">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="18dp"
                android:text="Minh họa câu hỏi"
                android:textColor="@color/gh_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/quiz_illustration_caption"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="42dp"
                android:text="Minh họa theo chủ đề hiện tại"
                android:textColor="@color/gh_text_secondary"
                android:textSize="14sp" />

            <View
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="46dp"
                android:background="@drawable/bg_chip_warning" />

            <View
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="84dp"
                android:background="@drawable/bg_primary_button_round" />
        </FrameLayout>

        <Button
            android:id="@+id/quiz_option_a"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_filter_unselected"
            android:gravity="start|center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textAllCaps="false"
            android:textColor="@color/gh_text_primary"
            android:text="A" />

        <Button
            android:id="@+id/quiz_option_b"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_filter_unselected"
            android:gravity="start|center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textAllCaps="false"
            android:textColor="@color/gh_text_primary"
            android:text="B" />

        <Button
            android:id="@+id/quiz_option_c"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_filter_unselected"
            android:gravity="start|center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textAllCaps="false"
            android:textColor="@color/gh_text_primary"
            android:text="C" />

        <Button
            android:id="@+id/quiz_option_d"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_filter_unselected"
            android:gravity="start|center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textAllCaps="false"
            android:textColor="@color/gh_text_primary"
            android:text="D" />

        <Button
            android:id="@+id/quiz_submit_answer"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_primary_button_round"
            android:text="Gửi đáp án"
            android:textAllCaps="false"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/quiz_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Chưa có câu hỏi trong DB cục bộ."
            android:textColor="@color/gh_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
