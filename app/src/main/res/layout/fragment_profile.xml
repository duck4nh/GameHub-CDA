<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gh_bg_screen">

    <!-- Background Decorative Glows (3 bubbles Color E9F6FF) -->
    <View
        android:id="@+id/glow_top_left"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:layout_marginStart="-150dp"
        android:layout_marginTop="-150dp"
        android:background="@drawable/bg_screen_glow_light_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/glow_center_right"
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:layout_marginEnd="-100dp"
        android:background="@drawable/bg_screen_glow_light_blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/glow_bottom_left"
        android:layout_width="380dp"
        android:layout_height="380dp"
        android:layout_marginStart="-120dp"
        android:layout_marginBottom="-100dp"
        android:background="@drawable/bg_screen_glow_light_blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="100dp">

            <!-- Profile Section -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProfilePic"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginTop="50dp"
                android:padding="2dp"
                android:src="@drawable/img_avatar_cat"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                app:strokeColor="#782A62"
                app:strokeWidth="2dp" />

            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="qyuhn"
                android:textColor="#000000"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivProfilePic" />

            <TextView
                android:id="@+id/tvRank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hạng: 2"
                android:textColor="#9CA3AF"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvUsername" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_edit_profile"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingLeft="32dp"
                android:paddingRight="32dp"
                android:text="Chỉnh sửa thông tin"
                android:textAllCaps="false"
                android:textColor="#251B6D"
                android:textSize="14sp"
                app:cornerRadius="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvRank" />

            <!-- Tiện ích Section -->
            <TextView
                android:id="@+id/tvUtilityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginTop="32dp"
                android:text="Tiện ích"
                android:textColor="#374151"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnEditProfile" />

            <!-- Rows for Utilities -->
            <LinearLayout
                android:id="@+id/llLeaderboard"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_row_blue"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvUtilityLabel">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_leaderboard" app:tint="#9CA3AF" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:text="Bảng xếp hạng" android:textColor="#251B6D" android:textSize="16sp" android:textStyle="bold" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="#D1D5DB" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llHistory"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_profile_row_green"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@id/llLeaderboard">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_statistics" app:tint="#9CA3AF" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:text="Lịch sử/Thống kê" android:textColor="#251B6D" android:textSize="16sp" android:textStyle="bold" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="#D1D5DB" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llFriends"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_profile_row_blue"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@id/llHistory">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_friends" app:tint="#9CA3AF" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:text="Bạn bè" android:textColor="#251B6D" android:textSize="16sp" android:textStyle="bold" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="#D1D5DB" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llCommunity"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_profile_row_green"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@id/llFriends">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_community" app:tint="#9CA3AF" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:text="Cộng đồng" android:textColor="#251B6D" android:textSize="16sp" android:textStyle="bold" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="#D1D5DB" />
            </LinearLayout>

            <!-- Cài đặt tài khoản Section -->
            <TextView
                android:id="@+id/tvSettingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginTop="24dp"
                android:text="Cài đặt tài khoản"
                android:textColor="#374151"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/llCommunity" />

            <LinearLayout
                android:id="@+id/llResetPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_row_blue"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvSettingsLabel">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_lock_lock" app:tint="#9CA3AF" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:text="Đặt lại mật khẩu" android:textColor="#251B6D" android:textSize="16sp" android:textStyle="bold" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" app:tint="#D1D5DB" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llSound"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_profile_row_green"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@id/llResetPassword">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_lock_silent_mode_off" app:tint="#9CA3AF" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:text="Âm thanh trò chơi" android:textColor="#251B6D" android:textSize="16sp" android:textStyle="bold" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swSound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:trackTint="#000000"
                    app:thumbTint="@color/white"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llLogout"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_profile_row_blue"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@id/llSound">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_revert" android:rotation="180" app:tint="#9CA3AF" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:text="Đăng xuất" android:textColor="#251B6D" android:textSize="16sp" android:textStyle="bold" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
